# Fake local credentials for docker-compose.yml only; never reuse in production.
# Settings reads process environment. uv run --env-file .env can load a local copy explicitly.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://telebotshop_dev:dev-local-only@127.0.0.1:55432/telebotshop_dev
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# Development/test polling only. Set locally via a secure environment; no real values in Git/chat.
# HTTP health and offline automated tests do not require these.
BOT_TOKEN=
OWNER_ID=
# Independent of APP_ENV. Use test only with a bot created inside Telegram Test Server.
TELEGRAM_ENVIRONMENT=main
# Required only for `telebotshop webhook`: 32-256 ASCII letters/digits/_/-, kept secret.
WEBHOOK_SECRET=

# Inventory polling requires these three values from a secure environment.
# JSON maps immutable positive versions to canonical base64 of distinct random 32-byte AES keys.
# When loading with uv --env-file, wrap the whole JSON value in single quotes.
# Keep every registered old version; the dedup key must differ from all encryption keys.
# Never use test fixture keys for any real inventory or rotate the dedup key by changing env.
INVENTORY_ENCRYPTION_KEYS=
INVENTORY_CURRENT_KEY_VERSION=1
INVENTORY_DEDUP_KEY=
LOW_STOCK_THRESHOLD=5

# Integration fixtures require APP_ENV=test and use only this exact disposable target.
TEST_DATABASE_URL=postgresql+asyncpg://telebotshop_test:test-local-only@127.0.0.1:55433/telebotshop_test

# Optional public terms file (.md/.txt); fill and approve all placeholders before enabling.
# SHOP_TERMS_PATH=C:/path/to/public-terms.md
