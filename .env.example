# Fake local credentials for docker-compose.yml only; never reuse in production.
# Settings reads process environment. uv run --env-file .env can load a local copy explicitly.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://telebotshop_dev:dev-local-only@127.0.0.1:55432/telebotshop_dev
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# Integration fixtures require APP_ENV=test and use only this exact disposable target.
TEST_DATABASE_URL=postgresql+asyncpg://telebotshop_test:test-local-only@127.0.0.1:55433/telebotshop_test
