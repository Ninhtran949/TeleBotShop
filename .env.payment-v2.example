# Sandbox only. Runtime file: .env.payment-v2 (ignored).
APP_ENV=test
DATABASE_URL=postgresql+asyncpg://telebotshop_pv2_sandbox:REPLACE_LOCAL_PASSWORD@127.0.0.1:55432/telebotshop_payment_v2_sandbox
HTTP_HOST=127.0.0.1
HTTP_PORT=8015
TELEGRAM_ENVIRONMENT=test
BOT_TOKEN=REPLACE_WITH_TEST_SERVER_BOT_TOKEN
OWNER_ID=REPLACE_WITH_TEST_SERVER_OWNER_ID
PV2_OPERATOR_ID=REPLACE_WITH_TEST_SERVER_OWNER_ID
STARS_CHECKOUT_ENABLED=false
CREDIT_WALLET_ENABLED=true
BANK_TOPUP_ENABLED=true
USDT_TOPUP_ENABLED=true
EXTERNAL_PAYMENTS_LIVE_ENABLED=false
BINANCE_READONLY_ENABLED=false
SANDBOX_USDT_VND_RATE=25000
SEPAY_BANK_CODE=FAKEBANK
SEPAY_ACCOUNT_NUMBER=FAKE-ACCOUNT
SEPAY_WEBHOOK_SECRET=REPLACE_WITH_SEPARATE_32_TO_256_BYTE_SANDBOX_HMAC_SECRET
PV2_OPERATOR_TOKEN=REPLACE_WITH_SEPARATE_32_TO_256_BYTE_OPERATOR_SECRET
INVENTORY_ENCRYPTION_KEYS=REPLACE_WITH_NEW_SANDBOX_BASE64_KEYRING_JSON
INVENTORY_CURRENT_KEY_VERSION=1
INVENTORY_DEDUP_KEY=REPLACE_WITH_NEW_SEPARATE_BASE64_32_BYTE_KEY
SHOP_TERMS_PATH=.cache/payment-v2-20261024/sandbox-terms.txt
# Add SEPAY_SANDBOX_API_TOKEN only for hosted Sandbox reconciliation.
# Optional read-only Binance: BINANCE_API_KEY/BINANCE_API_SECRET,
# USDT_NETWORK/USDT_TOKEN_CONTRACT/USDT_MINIMUM_CONFIRMATIONS.
# Exchange history cannot prove the token contract; it cannot auto-credit actual deposits alone.
